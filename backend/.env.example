ENVIRONMENT=production
# Supabase PostgreSQL connection string (optional when using the Supabase API):
DATABASE_URL=postgresql://postgres:[DB_PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-only credential. Never expose this value to the frontend.
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Optional server-side publishable/anon key for read-only integrations.
SUPABASE_KEY=your_supabase_publishable_key

SECRET_KEY=replace_with_a_long_random_secret
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
